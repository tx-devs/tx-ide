#!/usr/bin/env bash
# prefix+e: edit the tx session visible in the firing pane, in a popup over that pane.
set -eu

TX="$(tmux show-option -gv @tx-bin) $(tmux show-option -gv @tx-arguments)"
pane_id="$1"
client_name="$2"
pane_width=$(tmux display-message -p -t "$pane_id" '#{pane_width}')
popup_width=$((pane_width - 4))
((popup_width > 80)) && popup_width=80
((popup_width < 44)) && popup_width=44

# run-shell expands pane/client formats before the popup starts. display-popup's
# shell-command does not expand them, so pass the captured pane and client as literal arguments.
# Placed over the firing pane; the form needs 9 rows. The popup closes when the editor exits —
# a failure is reported on the status line.
BORDER_STYLE=$(tmux show-option -gv @tx-popup-operator-border-style 2>/dev/null || true)
INSET_LEFT=$(tmux show-option -gv @tx-operator-inset-left 2>/dev/null || printf '┤')
INSET_RIGHT=$(tmux show-option -gv @tx-operator-inset-right 2>/dev/null || printf '├')
printf -v edit_command '%s _edit-session %q %q' "$TX" "$pane_id" "$client_name"
if [ -n "$BORDER_STYLE" ]; then
  exec tmux display-popup -c "$client_name" -t "$pane_id" -E -w "$popup_width" -h 11 \
    -x '#{e|+:#{popup_pane_left},#{e|/:#{e|-:#{pane_width},#{popup_width}},2}}' \
    -y '#{e|+:#{popup_pane_top},1}' -b rounded \
    -S "$BORDER_STYLE" \
    -T "${INSET_LEFT} edit session ${INSET_RIGHT}" "$edit_command"
fi
exec tmux display-popup -c "$client_name" -t "$pane_id" -E -w "$popup_width" -h 11 \
  -x '#{e|+:#{popup_pane_left},#{e|/:#{e|-:#{pane_width},#{popup_width}},2}}' \
  -y '#{e|+:#{popup_pane_top},1}' -b rounded \
  -T "${INSET_LEFT} edit session ${INSET_RIGHT}" "$edit_command"
